# ==========================================
# CLASSIC FASHIONS ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Key (for Chatbot & AI Visual features)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Frontend API Base URL (optional - defaults to /api proxy in Vite)
VITE_API_BASE_URL=/api

# JWT Authentication Secret (for Admin APIs)
# Replace with a strong random 32+ character string in production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Default Admin Credentials (auto-seeded on initial boot)
ADMIN_EMAIL=admin@classicfashions.com
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
# Provide either a complete connection string:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/classic_fashions?sslmode=disable

# OR individual PostgreSQL connection parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_postgres_password
# PGDATABASE=classic_fashions

# NOTE: If PostgreSQL credentials are left unset or PostgreSQL is offline,
# the backend will automatically use the built-in local SQLite database
# at ./server/data/classic_fashions.db for seamless offline development.
