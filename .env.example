# ==========================================
# CLASSIC FASHIONS ENVIRONMENT TEMPLATE
# ==========================================

# Server Port (default: 3000)
PORT=3000
NODE_ENV=development

# Frontend API Base URL (defaults to /api)
VITE_API_BASE_URL=/api

# Admin Credentials (for production deployments)
# In development, default admin is auto-seeded if left unset
ADMIN_EMAIL=admin@classicfashions.com
ADMIN_PASSWORD=

# JWT Authentication Secret (for production deployments, minimum 32 characters)
# In development, a fallback dev secret is used if left unset
JWT_SECRET=

# Database Configuration (PostgreSQL)
# Optional: Leave unset to use the built-in SQLite database at server/data/classic_fashions.db
DATABASE_URL=
